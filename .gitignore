# ============================================================================
# Git Ignore for Kubernetes Microservices Monitoring Assignment (Go)
# ============================================================================
# This file specifies what should NOT be tracked in git.
# Everything else (code, configs, docs) SHOULD be tracked.
# ============================================================================

# ── Go binaries & build artifacts ──────────────────────────────────────────
# Don't track compiled binaries or build outputs
*.exe
*.exe~
*.dll
*.so
*.so.*
*.dylib
*.o
*.obj
*.a
*.out

# Go build cache — regenerated by `go build` every time
/bin/
/dist/
*.test

# Dependency vendoring — go mod handles this
/vendor/

# ── IDE & Editor artifacts ────────────────────────────────────────────────
# VS Code
.vscode/
*.code-workspace

# JetBrains (GoLand, IntelliJ)
.idea/
*.iml
*.iws
*.ipr
.idea_modules/

# vim/neovim
*.swp
*.swo
*~
.*.swp
.*.swo

# Sublime Text
*.sublime-project
*.sublime-workspace

# emacs
*~
\#*\#
.\#*

# ── Operating system files ───────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# Windows
Thumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
.directory
.Trash-*

# ── Environment & Secrets ────────────────────────────────────────────────
# Local environment overrides (NEVER commit secrets)
.env
.env.local
.env.*.local
*.pem
*.key
*.pfx

# ── Temporary & Log files ───────────────────────────────────────────────
# Build logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Temporary files
*.tmp
*.temp
*.bak
.cache/

# ── Docker & Container artifacts ────────────────────────────────────────
# Docker build outputs
.dockerignore
docker-compose.override.yml

# ── Test coverage & benchmarks ──────────────────────────────────────────
*.coverage
*.out
coverage.html
*.cpu
*.mem
*.prof
benchmarks/

# ── Go-specific cache ──────────────────────────────────────────────────────
# Go modules cache
go.sum.bak
go.mod.bak

# ── CI/CD & Automation ──────────────────────────────────────────────────
# GitHub Actions runtime
.github/workflows/runner-*/

# ── Kubernetes runtime files ───────────────────────────────────────────
# kubeconfig files (never commit cluster credentials)
kubeconfig
kubeconfig.*
~/.kube/

# ── Local development artifacts ────────────────────────────────────────
# Minikube data
.minikube/
minikube.log

# Kind cluster config
kind-config.yaml

# ── Terraform & IaC (if added later) ──────────────────────────────────
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# ── Misc ────────────────────────────────────────────────────────────────
# Backup files
*.backup
*.bkp
*.orig

# Compiled protocol buffers (if using gRPC)
*.pb.go

# Generated code (mocks, etc.)
*_mock.go
*_gen.go

# ============================================================================
#                        ✓ THINGS TO TRACK
# ============================================================================
#
# ✓ All source files: **/*.go
# ✓ Module files: go.mod (checked in for reproducible builds)
# ✓ Kubernetes manifests: k8s/**/*.yaml
# ✓ Dockerfiles: **/Dockerfile
# ✓ Documentation: **/*.md, IMPLEMENTATION_PLAN.md
# ✓ Scripts: scripts/*.sh
# ✓ Configuration: monitoring/**, config/**
# ✓ .gitignore itself (this file)
#
# ============================================================================
